# ─────────────────────────────────────────────────────────────────────────────
# MIRAGE environment template — copy to .env  (setup scripts do this automatically)
#
# EVERYTHING works with ALL sponsor keys blank: the app falls back to local
# SQLite + cached fixtures. Paste sponsor keys at 10:30 AM to go live.
# ─────────────────────────────────────────────────────────────────────────────

# ── Local service URLs (required, sane defaults for local dev) ────────────────
TARGET_MERCHANT_URL=http://localhost:8001
BACKEND_URL=http://localhost:8000
MCP_SERVER_URL=http://localhost:8002

# Frontend-facing URLs (consumed by Next.js at build/runtime)
NEXT_PUBLIC_API_URL=http://localhost:8000
# URL encoded into the on-stage QR code so judges' phones hit the live target
NEXT_PUBLIC_STAGE_TARGET_URL=http://localhost:8001

# ── Supabase (paste at 10:30 AM — blank ⇒ SQLite fallback in artifacts/) ──────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Grok Bot (paste at 10:30 AM — blank ⇒ events logged locally only) ─────────
# Outbound webhook MIRAGE calls to hand Grok Bot mission events
GROKBOT_WEBHOOK_URL=
# Bearer token MIRAGE sends to Grok Bot / expects on inbound webhooks
GROKBOT_API_KEY=

# ── OSINT providers (blank ⇒ cached fixtures in integrations/fixtures/) ───────
TAVILY_API_KEY=
COMPANIES_HOUSE_API_KEY=

# ── Behaviour flags (optional) ────────────────────────────────────────────────
# HEADLESS=false opens a visible browser for debugging the probe
HEADLESS=true
# Directory all captured evidence + the SQLite fallback DB are written to
ARTIFACTS_DIR=artifacts
